---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { site, contacto, redes } from "../data/site.js";
import "../styles/global.css";
import "../styles/paginas.css";

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  /** Dimensiones reales del archivo de "imagen" — WhatsApp/LinkedIn necesitan
      og:image:width/height explícitos para decidir mostrar la vista previa
      grande en vez de una miniatura al costado. */
  imagenAncho?: number;
  imagenAlto?: number;
  tipo?: "website" | "article";
  noindex?: boolean;
}

const {
  titulo,
  descripcion,
  imagen = "/assets/images/og-talentopolis.jpg",
  imagenAncho = 1200,
  imagenAlto = 630,
  tipo = "website",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.dominio).href;
const imagenAbs = new URL(imagen, Astro.site ?? site.dominio).href;
const imagenTipo = imagen.endsWith(".png") ? "image/png" : imagen.endsWith(".webp") ? "image/webp" : "image/jpeg";
const tituloCompleto = titulo.includes("Talentópolis")
  ? titulo
  : `${titulo} — Talentópolis`;

// @id estable: permite enlazar otras entidades (Person del equipo, WebSite)
// a esta misma Organization en el grafo de conocimiento (entity SEO).
const organizacion = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.dominio}/#organization`,
  name: site.nombre,
  url: site.dominio,
  logo: `${site.dominio}/assets/images/logo-talentopolis.webp`,
  description: site.descripcion,
  email: contacto.email,
  telephone: `+${contacto.telefonoE164}`,
  address: {
    "@type": "PostalAddress",
    streetAddress: contacto.direccion,
    addressLocality: "Providencia",
    addressRegion: "Región Metropolitana",
    addressCountry: "CL",
  },
  sameAs: redes.map((r) => r.url),
};

// WebSite enlazado a la Organization: refuerza la identidad de la entidad
// sitio-marca en el grafo de conocimiento (sin SearchAction: el sitio no
// tiene buscador interno, y declarar uno inexistente sería datos falsos).
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.dominio}/#website`,
  name: site.nombre,
  url: site.dominio,
  inLanguage: "es-CL",
  publisher: { "@id": `${site.dominio}/#organization` },
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:secure_url" content={imagenAbs} />
    <meta property="og:image:type" content={imagenTipo} />
    <meta property="og:image:width" content={String(imagenAncho)} />
    <meta property="og:image:height" content={String(imagenAlto)} />
    <meta property="og:image:alt" content={tituloCompleto} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />

    <meta name="theme-color" content="#000B42" />
    {/* Evita que el modo oscuro automático de Samsung Internet / Chrome Android
        altere los colores: el sitio ya está diseñado en esquema oscuro. */}
    <meta name="color-scheme" content="dark" />

    {/* Samsung Internet aplica su propio "modo oscuro" que ignora color-scheme y
        OSCURECE los fondos. Como los titulares toman su color de un degradado de
        fondo (background-clip: text), ahí el naranjo se volvía rojo oscuro. Se
        marca el navegador para servirle un naranjo sólido (ver global.css).
        Va en línea y antes de pintar para que no haya parpadeo. */}
    <script is:inline>
      if (/SamsungBrowser/i.test(navigator.userAgent)) {
        document.documentElement.classList.add("samsung");
      }
    </script>
    {/* .ico primero como respaldo para lectores RSS, rastreadores y navegadores
        antiguos; los modernos igual prefieren el SVG que va debajo. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/assets/fonts/montserrat-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/roboto-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {/* Google Analytics 4 — configurado para contar también las navegaciones
        internas (el sitio usa transiciones de página). */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PGP6XHMQCT" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      // send_page_view:false — la vista se envía manualmente en cada página
      // (incluida la inicial) para no depender del auto-tracking con transiciones.
      gtag("config", "G-PGP6XHMQCT", { send_page_view: false });
      if (!window.__gaBound) {
        window.__gaBound = true;
        document.addEventListener("astro:page-load", function () {
          gtag("event", "page_view", {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        });
      }
    </script>

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <Header transition:persist />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <button class="to-top" type="button" data-top aria-label="Volver arriba" transition:persist>
      <Icon nombre="arrow" size={20} />
    </button>

    {/* Capa de animación premium — self-hosted (sin CDN). Se cargan una vez;
        con las transiciones de Astro persisten entre páginas. main.js orquesta
        el smooth-scroll (Lenis) y el parallax (GSAP) respetando reduce-motion. */}
    <script src="/js/vendor/gsap.min.js" defer is:inline></script>
    <script src="/js/vendor/ScrollTrigger.min.js" defer is:inline></script>
    <script src="/js/vendor/SplitText.min.js" defer is:inline></script>
    <script src="/js/vendor/lenis.min.js" defer is:inline></script>
    <script src="/js/main.js" defer is:inline></script>
  </body>
</html>
