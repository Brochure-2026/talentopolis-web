---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProgramGrid from "../components/ProgramGrid.astro";
---

<Base
  titulo="Página no encontrada — Talentópolis"
  descripcion="La página que buscas no existe o cambió de dirección."
  noindex={true}
>
  <section class="section bg-glow">
    <div class="wrap cierre">
      <p class="eyebrow">Error 404</p>
      <h1 class="section-title">Esta página no <strong>existe</strong></h1>
      <p>
        Puede que el enlace esté mal escrito o que el contenido haya cambiado de
        dirección. Desde aquí puedes volver a encontrar lo que buscabas.
      </p>
      <p style="margin-top:28px" class="ctas" >
        <a class="btn btn--primary" href="/">Volver al inicio</a>
        <a class="btn btn--ghost" href="/servicios/">Ver servicios</a>
        <a class="btn btn--ghost" href="/contacto/">
          <Icon nombre="mail" size={18} />
          Contacto
        </a>
      </p>
    </div>
  </section>

  <section class="section bg-deep">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Quizá buscabas</p>
        <h2 class="section-title">Nuestros <strong>programas</strong></h2>
      </div>
      <ProgramGrid mostrarProximamente={false} />
    </div>
  </section>
</Base>
