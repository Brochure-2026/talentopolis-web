---
/*
  HeroSequence.astro — Intro cinematográfica: secuencia de frames scrubbeada
  por el scroll (técnica tipo Apple). Va ANTES del hero, no lo reemplaza.

  Solo desktop: en móvil / prefers-reduced-motion NO se muestra la intro (la
  sección se oculta por CSS) y se va directo al hero.
*/
const FRAMES = 165;
const PATH = "/assets/images/hero-seq/frame-";
const poster = `${PATH}001.webp`;
---

<section class="seq" data-seq data-seq-frames={FRAMES} data-seq-path={PATH} aria-label="Introducción Talentópolis">
  <div class="seq__sticky">
    <img class="seq__poster" src={poster} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <canvas class="seq__canvas" aria-hidden="true"></canvas>
    <div class="seq__veil" aria-hidden="true"></div>
    <div class="seq__hint" data-seq-hint aria-hidden="true">
      <span class="seq__hint-txt">Desliza para comenzar</span>
      <span class="seq__hint-mouse"></span>
    </div>
  </div>
</section>

<script>
  function bootSeq() {
    const seq = document.querySelector("[data-seq]");
    if (!seq || seq.dataset.booted) return;
    const canvas = seq.querySelector(".seq__canvas");
    if (!canvas) return;
    seq.dataset.booted = "1";

    // Solo desktop con movimiento: en móvil / reduce-motion no se anima ni se
    // cargan frames (la sección se oculta por CSS y se va directo al hero).
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const small = matchMedia("(max-width: 860px)").matches;
    if (reduce || small) return;

    const total = Number(seq.dataset.seqFrames);
    const base = seq.dataset.seqPath;
    const path = (i) => `${base}${String(i + 1).padStart(3, "0")}.webp`;

    const ctx = canvas.getContext("2d");
    const frames = new Array(total);
    let current = -1, raf = 0;

    const nearest = (idx) => {
      if (frames[idx]?.complete && frames[idx].naturalWidth) return idx;
      for (let d = 1; d < total; d++) {
        if (frames[idx - d]?.complete && frames[idx - d].naturalWidth) return idx - d;
        if (frames[idx + d]?.complete && frames[idx + d].naturalWidth) return idx + d;
      }
      return -1;
    };

    function draw(idx) {
      const img = frames[idx];
      if (!img || !img.complete || !img.naturalWidth) return;
      // Interpolación de alta calidad al reescalar (mejora el upscaling del canvas).
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      const cw = canvas.width, ch = canvas.height;
      const ir = img.naturalWidth / img.naturalHeight, cr = cw / ch;
      let dw, dh, dx, dy;
      if (ir > cr) { dh = ch; dw = ch * ir; dx = (cw - dw) / 2; dy = 0; }
      else { dw = cw; dh = cw / ir; dx = 0; dy = (ch - dh) / 2; }
      ctx.drawImage(img, dx, dy, dw, dh);
      current = idx;
    }

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      const n = current >= 0 ? current : nearest(0);
      if (n >= 0) draw(n);
    }

    function update() {
      const scrollable = seq.offsetHeight - innerHeight;
      // Progreso atado al scroll desde el tope de la página (la intro es lo
      // primero): la animación arranca de inmediato, sin el pequeño scroll
      // muerto que provocaba el alto del header.
      const p = scrollable > 0 ? Math.min(Math.max(scrollY / scrollable, 0), 1) : 0;
      const idx = Math.min(total - 1, Math.floor(p * total));
      const use = nearest(idx);
      if (use >= 0 && use !== current) draw(use);
      // Oculta la pista de scroll apenas empieza el movimiento.
      if (p > 0.02) seq.classList.add("seq--moving");
      progreso = p;
    }

    /* --- Snap al terminar la animación -------------------------------------
       Cuando el usuario deja de scrollear con la secuencia ya completa, la
       página salta sola hasta el hero en vez de dejarlo a medio camino.
       Solo hacia adelante y solo tras soltar el scroll, para no pelear con
       quien está recorriendo la animación a su ritmo. */
    const UMBRAL = 0.92;   // desde qué progreso se considera "terminada"
    const ESPERA = 140;    // ms sin scrollear antes de saltar
    let progreso = 0, snapTimer = 0, yaSalto = false, ultimaY = scrollY;

    function intentarSnap() {
      const bajando = scrollY > ultimaY;
      ultimaY = scrollY;
      if (progreso < UMBRAL) { yaSalto = false; return; } // volvió atrás: rearma
      if (yaSalto || !bajando) return;

      // Fin de la sección = inicio del hero: dejarlo pegado arriba del viewport.
      const destino = Math.round(seq.getBoundingClientRect().bottom + scrollY);
      if (scrollY >= destino - 2) return; // ya está donde corresponde

      yaSalto = true;
      const lenis = window.__lenis;
      if (lenis) lenis.scrollTo(destino, { duration: 0.9 });
      else scrollTo({ top: destino, behavior: "smooth" });
    }

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); });
      clearTimeout(snapTimer);
      snapTimer = setTimeout(intentarSnap, ESPERA);
    };

    seq.classList.add("is-scroll");
    resize();

    // Precarga progresiva (no bloquea): el poster ya se ve; los frames van llegando.
    for (let i = 0; i < total; i++) {
      const img = new Image();
      img.decoding = "async";
      img.onload = () => { if (current < 0 || nearest(current) !== current) update(); };
      img.src = path(i);
      frames[i] = img;
    }

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", resize);
    update();

    const cleanup = () => {
      cancelAnimationFrame(raf);
      clearTimeout(snapTimer);
      removeEventListener("scroll", onScroll);
      removeEventListener("resize", resize);
      document.removeEventListener("astro:before-swap", cleanup);
    };
    document.addEventListener("astro:before-swap", cleanup);
  }

  document.addEventListener("astro:page-load", bootSeq);
</script>
