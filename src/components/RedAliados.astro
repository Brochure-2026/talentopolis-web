---
import Icon from "./Icon.astro";
import { aliados } from "../data/site.js";
---

<aside class="aliados reveal" aria-label="Red de aliados audiovisuales">
  <p class="aliados__lead">
    <span class="aliados__plus">+</span>
    Una amplia, variada y robusta red de <strong>partners y aliados</strong>
    del mundo audiovisual
  </p>

  <ul class="aliados__logos">
    {
      aliados.map((a) => (
        <li>
          <Icon nombre={a.icono} size={26} />
          <span>{a.nombre}</span>
        </li>
      ))
    }
  </ul>
</aside>
