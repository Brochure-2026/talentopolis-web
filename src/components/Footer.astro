---
import Icon from "./Icon.astro";
import { contacto, redes, whatsappUrl } from "../data/site.js";
import { programas } from "../data/programas.js";
import { servicios } from "../data/servicios.js";
---

<footer class="site-footer">
  <div class="wrap footer">
    <div class="footer__grid">
      <div>
        <img
          class="footer__logo"
          src="/assets/images/logo-talentopolis.webp"
          alt="Talentópolis"
          width="190"
          height="38"
          loading="lazy"
        />
        <p>
          En Talentópolis conectamos educación, trabajo e innovación a través de
          <strong>contenidos audiovisuales que inspiran y transforman</strong>.
          Creamos ideas que abren conversaciones y formatos que generan impacto.
        </p>
      </div>

      <div>
        <h4>Programas</h4>
        <ul class="footer__links">
          {programas.map((p) => <li><a href={p.url}>{p.nombre}</a></li>)}
        </ul>
      </div>

      <div>
        <h4>Servicios</h4>
        <ul class="footer__links">
          {servicios.map((s) => <li><a href={`/${s.slug}/`}>{s.nombre}</a></li>)}
        </ul>
      </div>

      <div>
        <h4>Contacto</h4>
        <ul class="footer__contact">
          <li>
            <a href={whatsappUrl()} target="_blank" rel="noopener">
              <Icon nombre="whatsapp" size={17} />
              {contacto.telefono}
            </a>
          </li>
          <li>
            <a href={`mailto:${contacto.email}`}>
              <Icon nombre="mail" size={17} />
              {contacto.email}
            </a>
          </li>
          <li>
            <a href={contacto.mapa} target="_blank" rel="noopener">
              <Icon nombre="pin" size={17} />
              <span>{contacto.direccion}<br />{contacto.comuna}</span>
            </a>
          </li>
        </ul>

        <div class="social">
          {
            redes.map((r) => (
              <a href={r.url} target="_blank" rel="noopener" aria-label={`Talentópolis en ${r.nombre}`}>
                <Icon nombre={r.icono} size={19} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        © <span data-year>2026</span> Talentópolis · Productora audiovisual y medio
        multiplataforma · {contacto.comuna}
      </p>
    </div>
  </div>
</footer>
