const icono = paths[nombre] ?? paths.arrow;
const viewBox = icono.extra?.startsWith("VIEWBOX:")
  ? icono.extra.slice(8)
  : "0 0 24 24";
const extraMarkup = icono.extra?.startsWith("VIEWBOX:") ? "" : (icono.extra ?? "");
const attrs = icono.modo === "relleno" ? relleno : trazo;
---

<svg
  viewBox={viewBox}
  width={size}
  height={size}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  {icono.d.map((d) => <path d={d} {...attrs} />)}
  <Fragment set:html={extraMarkup} />
</svg>
