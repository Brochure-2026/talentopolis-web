---
/*
  Hero3D.astro — Micrófono de estudio en 3D real (Three.js).
  Self-hosted: Astro empaqueta three en el bundle (sin CDN). El entorno de
  reflejos es procedural (RoomEnvironment), así no depende de archivos HDRI.

  Carga dinámica: three (~140KB gzip) SOLO se descarga si el equipo es capaz
  (desktop + WebGL + sin prefers-reduced-motion). En cualquier otro caso queda
  la portada fotográfica del hero como fallback y no se baja nada.
*/
---

<canvas class="hero3d" data-hero3d aria-hidden="true"></canvas>

<script>
  const ORANGE = 0xff6f2c;
  const TEAL = 0x17b8a6;

  function capaz(canvas) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    if (matchMedia("(max-width: 860px)").matches) return false;
    if (navigator.deviceMemory && navigator.deviceMemory < 4) return false;
    try {
      return !!(canvas.getContext("webgl2") || canvas.getContext("webgl"));
    } catch {
      return false;
    }
  }

  function construirMicro(THREE) {
    const mic = new THREE.Group();

    const cuerpo = new THREE.MeshStandardMaterial({ color: 0x20242b, metalness: 1, roughness: 0.28 });
    const rejilla = new THREE.MeshStandardMaterial({ color: 0x2b2f37, metalness: 1, roughness: 0.55 });
    const oscuro = new THREE.MeshStandardMaterial({ color: 0x14171d, metalness: 0.9, roughness: 0.4 });
    const led = new THREE.MeshStandardMaterial({ color: ORANGE, emissive: ORANGE, emissiveIntensity: 3, metalness: 0.3, roughness: 0.4 });

    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.54, 1.6, 64), cuerpo);
    body.position.y = -0.45;
    mic.add(body);

    const base = new THREE.Mesh(new THREE.CylinderGeometry(0.56, 0.5, 0.18, 64), oscuro);
    base.position.y = -1.28;
    mic.add(base);

    const head = new THREE.Mesh(new THREE.CylinderGeometry(0.58, 0.58, 1.05, 64), rejilla);
    head.position.y = 0.75;
    mic.add(head);

    const cap = new THREE.Mesh(new THREE.SphereGeometry(0.58, 48, 24, 0, Math.PI * 2, 0, Math.PI / 2), rejilla);
    cap.position.y = 1.27;
    mic.add(cap);

    for (let i = 0; i < 6; i++) {
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.585, 0.012, 12, 72), oscuro);
      ring.rotation.x = Math.PI / 2;
      ring.position.y = 0.35 + i * 0.17;
      mic.add(ring);
    }

    const ledRing = new THREE.Mesh(new THREE.TorusGeometry(0.5, 0.028, 20, 72), led);
    ledRing.rotation.x = Math.PI / 2;
    ledRing.position.y = 0.12;
    mic.add(ledRing);

    const arco = new THREE.Mesh(new THREE.TorusGeometry(1.0, 0.045, 16, 80, Math.PI), oscuro);
    arco.position.y = -0.35;
    arco.rotation.z = Math.PI;
    mic.add(arco);
    for (const s of [-1, 1]) {
      const pivote = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.16, 24), oscuro);
      pivote.rotation.z = Math.PI / 2;
      pivote.position.set(s * 0.98, -0.35, 0);
      mic.add(pivote);
    }

    return mic;
  }

  async function montar(canvas) {
    if (canvas.dataset.mounted || !capaz(canvas)) return;
    canvas.dataset.mounted = "1";

    const THREE = await import("three");
    const { RoomEnvironment } = await import("three/examples/jsm/environments/RoomEnvironment.js");

    const stage = canvas.parentElement; // .hero__stage
    stage.classList.add("is-3d");

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    camera.position.set(0, 0, 7);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const key = new THREE.SpotLight(ORANGE, 120, 25, Math.PI / 5, 0.6, 1.6);
    key.position.set(4, 5, 5);
    scene.add(key);
    const rim = new THREE.PointLight(TEAL, 40, 30, 1.6);
    rim.position.set(-5, -1, -3);
    scene.add(rim);
    const top = new THREE.DirectionalLight(0xcfe0ff, 1.4);
    top.position.set(-2, 6, 3);
    scene.add(top);
    scene.add(new THREE.HemisphereLight(0x6a7890, 0x05070d, 0.5));

    const mic = construirMicro(THREE);
    mic.rotation.set(0.12, -0.35, 0.04);
    scene.add(mic);

    let tx = 0, ty = 0, px = 0, py = 0;
    const onMove = (e) => {
      tx = e.clientX / innerWidth - 0.5;
      ty = e.clientY / innerHeight - 0.5;
    };
    addEventListener("pointermove", onMove, { passive: true });

    const resize = () => {
      const r = stage.getBoundingClientRect();
      if (!r.width) return;
      renderer.setSize(r.width, r.height, false);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    };
    resize();
    addEventListener("resize", resize);

    const clock = new THREE.Clock();
    let raf = 0, visible = true, time = 0;
    const loop = () => {
      if (!visible) { raf = 0; return; }
      time += Math.min(clock.getDelta(), 0.05); // acumulador propio: sin saltos al reanudar
      px += (tx - px) * 0.05;
      py += (ty - py) * 0.05;
      const scroll = Math.min(scrollY / innerHeight, 1);
      mic.rotation.y = -0.35 + px * 0.9 + time * 0.12;
      mic.rotation.x = 0.12 + py * 0.45 + scroll * 0.25;
      mic.position.y = Math.sin(time * 1.1) * 0.05 - scroll * 0.4;
      renderer.render(scene, camera);
      raf = requestAnimationFrame(loop);
    };

    // Pausa el render cuando el hero sale de pantalla (ahorra GPU y batería).
    const io = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) { clock.getDelta(); loop(); }
    }, { threshold: 0 });
    io.observe(stage);
    loop();

    const cleanup = () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      removeEventListener("pointermove", onMove);
      removeEventListener("resize", resize);
      renderer.dispose();
      pmrem.dispose();
      document.removeEventListener("astro:before-swap", cleanup);
    };
    document.addEventListener("astro:before-swap", cleanup);
  }

  const boot = () => document.querySelectorAll("[data-hero3d]").forEach(montar);
  document.addEventListener("astro:page-load", boot);
</script>
